---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import GoldRing from '../components/GoldRing.astro';
import Testimonials from '../components/Testimonials.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { home, gallery, testimonials, paragraphs } from '../lib/site';
import { media } from '../lib/media';

const hero = home.hero;
const heroImage = media(hero.image);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = gallery.items
  .map((item, index) => ({ ...item, index }))
  .filter((i) => i.featured)
  .slice(0, 5);

// Editorial placement: a tall lead image, then a staggered supporting set.
const layout = [
  'md:col-span-5 md:row-span-2',
  'md:col-span-7',
  'md:col-span-4 md:mt-10',
  'md:col-span-3 md:-mt-6',
  'md:col-span-5 md:col-start-7',
];
const ratios = ['4 / 5.4', '3 / 2', '1 / 1', '3 / 4', '4 / 3'];
---

<Base page="home" overlay includeBusiness image={hero.image}>
  <!-- ============================================================== HERO -->
  <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden" aria-labelledby="hero-heading">
    <div class="absolute inset-0 -z-10" data-parallax>
      <Photo
        src={heroImage}
        alt={hero.imageAlt}
        priority
        reveal={false}
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="100vw"
        class="!h-[112%] w-full"
        position="50% 30%"
      />
    </div>
    <!-- Soft vignette so the photograph stays the hero while the text stays legible. -->
    <div class="absolute inset-0 -z-0 bg-gradient-to-t from-ink via-ink/35 to-ink/10"></div>
    <div class="absolute inset-0 -z-0 bg-gradient-to-r from-ink/60 via-transparent to-transparent"></div>

    <div class="wrap relative z-10 pb-16 pt-40 md:pb-24">
      <div class="max-w-3xl" data-stagger>
        <p class="eyebrow" data-reveal>{hero.eyebrow}</p>
        <h1 id="hero-heading" class="display mt-6" data-reveal>{hero.headline}</h1>
        <p class="lede mt-7 !text-cream/80" data-reveal>{hero.text}</p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8" data-reveal>
          <a href="/contact" class="btn btn-primary">{hero.primaryCta}<span class="arrow" aria-hidden="true"></span></a>
          <a href="/portfolio" class="link-quiet">{hero.secondaryCta}<span class="arrow" aria-hidden="true"></span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================= FEATURED -->
  <section class="section" aria-labelledby="featured-heading">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div data-stagger>
          <p class="eyebrow" data-reveal>{home.featured.eyebrow}</p>
          <h2 id="featured-heading" class="h2 mt-4 max-w-xl" data-reveal>{home.featured.heading}</h2>
        </div>
        <a href="/portfolio" class="link-quiet self-start md:self-auto" data-reveal>{home.featured.linkLabel}<span class="arrow" aria-hidden="true"></span></a>
      </div>

      <ul class="mt-14 grid gap-5 md:grid-cols-12 md:gap-6">
        {featured.map((item, i) => (
          <li class={layout[i]}>
            <a href={`/portfolio#photo-${item.index}`} class="group block" aria-label={`View portfolio: ${item.caption}`}>
              <Photo
                src={media(item.image)}
                alt={item.alt}
                ratio={ratios[i]}
                zoom
                keyline={i === 0}
                sizes={i === 0 ? '(min-width: 768px) 40vw, 100vw' : '(min-width: 768px) 45vw, 100vw'}
              />
              <p class="mt-3 text-sm tracking-wide text-muted transition-colors group-hover:text-champagne">{item.caption}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================================================ ABOUT -->
  <section class="section surface-2" aria-labelledby="about-heading">
    <div class="wrap grid items-center gap-14 md:grid-cols-12 md:gap-8">
      <div class="relative md:col-span-5 md:col-start-1">
        <GoldRing class="pointer-events-none absolute -left-10 -top-10 z-0 h-[115%] w-[115%] max-w-none opacity-80" />
        <Photo
          src={media(home.aboutIntro.image)}
          alt={home.aboutIntro.imageAlt}
          ratio="4 / 5"
          class="relative z-10"
          sizes="(min-width: 768px) 40vw, 100vw"
        />
      </div>
      <div class="md:col-span-6 md:col-start-7" data-stagger>
        <p class="eyebrow" data-reveal>{home.aboutIntro.eyebrow}</p>
        <h2 id="about-heading" class="h2 mt-4" data-reveal>{home.aboutIntro.heading}</h2>
        <div class="prose-lux mt-8" data-reveal>
          {paragraphs(home.aboutIntro.text).map((p) => <p>{p}</p>)}
        </div>
        <p class="script mt-8" data-reveal aria-hidden="true">Nam</p>
        <a href="/about" class="link-quiet mt-6" data-reveal>{home.aboutIntro.linkLabel}<span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- ========================================================== SERVICES -->
  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="grid gap-8 md:grid-cols-12">
        <div class="md:col-span-6" data-stagger>
          <p class="eyebrow" data-reveal>{home.servicesIntro.eyebrow}</p>
          <h2 id="services-heading" class="h2 mt-4" data-reveal>{home.servicesIntro.heading}</h2>
        </div>
        <p class="text-muted md:col-span-4 md:col-start-9 md:self-end" data-reveal>{home.servicesIntro.text}</p>
      </div>

      <ol class="mt-16 border-t border-line">
        {services.map((s, i) => (
          <li class="border-b border-line">
            <a
              href={`/services/${s.id}`}
              class="group grid items-center gap-6 py-9 md:grid-cols-12 md:gap-8 md:py-12"
              data-reveal
            >
              <span class="font-display text-2xl text-antique md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
              <div class="md:col-span-5">
                <h3 class="h3 transition-colors group-hover:text-champagne">{s.data.title}</h3>
              </div>
              <p class="max-w-md text-muted md:col-span-4">{s.data.summary}</p>
              <div class="hidden md:col-span-2 md:block">
                <Photo
                  src={media(s.data.image)}
                  alt={s.data.imageAlt}
                  ratio="4 / 5"
                  reveal={false}
                  widths={[240, 400]}
                  sizes="12vw"
                  class="w-24 translate-y-1 opacity-70 grayscale-[40%] transition duration-700 group-hover:opacity-100 group-hover:grayscale-0 md:ml-auto"
                />
              </div>
            </a>
          </li>
        ))}
      </ol>
      <div class="mt-10">
        <a href="/services" class="link-quiet">All services<span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- ====================================================== TESTIMONIALS -->
  <section class="section surface-2" aria-labelledby="testimonials-heading">
    <div class="wrap">
      <div data-stagger>
        <p class="eyebrow" data-reveal>{home.testimonialsIntro.eyebrow}</p>
        <h2 id="testimonials-heading" class="h2 mt-4" data-reveal>{home.testimonialsIntro.heading}</h2>
      </div>
      <div class="mt-14">
        {
          testimonials.items.length > 0 ? (
            <>
              <Testimonials limit={4} />
              <div class="mt-14">
                <a href="/testimonials" class="link-quiet">Read more reviews<span class="arrow" aria-hidden="true"></span></a>
              </div>
            </>
          ) : (
            <p class="max-w-xl text-muted">{testimonials.intro}</p>
          )
        }
      </div>
    </div>
  </section>

  <InstagramStrip />
  <ClosingCta />
</Base>
