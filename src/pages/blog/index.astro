---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import PageHeader from '../../components/PageHeader.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { media } from '../../lib/media';
import { formatDate } from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Journal', path: '/blog' },
];
const [lead, ...rest] = posts;
---

<Base page="blog" breadcrumbs={trail} image={lead?.data.image}>
  <PageHeader
    eyebrow="Journal"
    title="Bridal beauty, *thoughtfully* explained"
    intro="Practical advice on skincare, timings and makeup for your wedding, shared from our Leicester studio."
    trail={trail}
  />

  <section class="pb-28 md:pb-44" aria-label="Journal articles">
    <div class="wrap">
      {
        posts.length === 0 && <p class="text-muted">We are writing our first articles. Please check back soon.</p>
      }
      {
        lead && (
          <article class="grid items-center gap-10 md:grid-cols-12 md:gap-8">
            <a href={`/blog/${lead.id}`} class="block md:col-span-7" tabindex="-1" aria-hidden="true">
              <Photo src={media(lead.data.image)} alt="" ratio="3 / 2" zoom priority sizes="(min-width: 768px) 58vw, 100vw" />
            </a>
            <div class="md:col-span-4 md:col-start-9" data-stagger>
              <p class="eyebrow" data-reveal>{lead.data.category} · {formatDate(lead.data.date)}</p>
              <h2 class="h2 mt-4" data-reveal><a href={`/blog/${lead.id}`} class="hover:text-gold-deep">{lead.data.title}</a></h2>
              <p class="mt-5 text-muted" data-reveal>{lead.data.description}</p>
              <a href={`/blog/${lead.id}`} class="link-quiet mt-8" data-reveal>Read the article<span class="arrow" aria-hidden="true"></span></a>
            </div>
          </article>
        )
      }
      {
        rest.length > 0 && (
          <ul class="mt-28 grid gap-16 md:grid-cols-2 md:gap-16">
            {rest.map((p) => (
              <li class="md:even:mt-24">
                <article>
                  <a href={`/blog/${p.id}`} class="block" tabindex="-1" aria-hidden="true">
                    <Photo src={media(p.data.image)} alt="" ratio="3 / 2" zoom sizes="(min-width: 768px) 46vw, 100vw" />
                  </a>
                  <p class="eyebrow mt-6">{p.data.category} · {formatDate(p.data.date)}</p>
                  <h2 class="h3 mt-3"><a href={`/blog/${p.id}`} class="hover:text-gold-deep">{p.data.title}</a></h2>
                  <p class="mt-3 text-muted">{p.data.description}</p>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <ClosingCta />
</Base>
