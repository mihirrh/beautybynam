---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Testimonials from '../components/Testimonials.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { testimonials, settings } from '../lib/site';

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Testimonials', path: '/testimonials' },
];
const hasItems = testimonials.items.length > 0;
---

<Base page="testimonials" breadcrumbs={trail}>
  <PageHeader eyebrow="Testimonials" title={testimonials.heading} trail={trail} />

  <section class="pb-28 md:pb-44" aria-label="Client testimonials">
    <div class="wrap">
      {
        hasItems ? (
          <Testimonials variant="list" />
        ) : (
          <div class="max-w-xl border-t border-line pt-8">
            <p class="text-muted">{testimonials.intro}</p>
            <a href={settings.instagramUrl} target="_blank" rel="noopener noreferrer" class="link-quiet mt-8">
              See recent work on Instagram<span class="arrow" aria-hidden="true"></span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        )
      }
    </div>
  </section>

  <ClosingCta />
</Base>
