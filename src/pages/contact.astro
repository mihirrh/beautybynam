---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FaqList from '../components/FaqList.astro';
import { contact, settings, faqs, has, telHref } from '../lib/site';
import { faqSchema } from '../lib/schema';
import { em } from '../lib/text';

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
---

<Base page="contact" breadcrumbs={trail} schema={[faqSchema(faqs.items)]}>
  <PageHeader eyebrow={contact.eyebrow} title={contact.heading} intro={contact.intro} trail={trail} />

  <section class="pb-28 md:pb-40">
    <div class="wrap grid gap-16 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-7">
        <h2 class="h3">{contact.formHeading}</h2>
        <p class="mt-3 text-muted">{contact.responseNote}</p>

        <div id="form-success" class="mt-10 hidden border border-line bg-taupe p-8" role="status" tabindex="-1">
          <h3 class="h3">{contact.successHeading}</h3>
          <p class="mt-4 text-muted">{contact.successMessage}</p>
        </div>

        <div id="form-error" class="mt-10 hidden border border-error p-6" role="alert" tabindex="-1">
          <p class="text-error" data-error-text>
            We are sorry, your enquiry could not be sent. Please try again in a moment, or message us on Instagram:
            <a href={settings.instagramUrl} class="underline" target="_blank" rel="noopener noreferrer">@{settings.instagramHandle}</a>.
          </p>
        </div>

        <form id="enquiry-form" class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2" method="post" action="/api/enquiry" novalidate>
          <div class="field">
            <label for="name">Your name <span aria-hidden="true">*</span></label>
            <input class="input" id="name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="name-error" />
            <p class="field-error" id="name-error"></p>
          </div>

          <div class="field">
            <label for="email">Email <span aria-hidden="true">*</span></label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="email-error" />
            <p class="field-error" id="email-error"></p>
          </div>

          <div class="field">
            <label for="phone">Phone <span aria-hidden="true">*</span></label>
            <input class="input" id="phone" name="phone" type="tel" autocomplete="tel" required maxlength="30" aria-describedby="phone-error" />
            <p class="field-error" id="phone-error"></p>
          </div>

          <div class="field">
            <label for="date">Wedding date <span aria-hidden="true">*</span></label>
            <input class="input" id="date" name="date" type="date" required aria-describedby="date-error" />
            <p class="field-error" id="date-error"></p>
          </div>

          <div class="field sm:col-span-2">
            <label for="venue">Venue or location <span aria-hidden="true">*</span></label>
            <input class="input" id="venue" name="venue" type="text" required maxlength="200" aria-describedby="venue-error venue-hint" />
            <span class="hint" id="venue-hint">Travel is quoted from this location.</span>
            <p class="field-error" id="venue-error"></p>
          </div>

          <fieldset class="field sm:col-span-2" aria-describedby="services-error">
            <legend>Services required <span aria-hidden="true">*</span></legend>
            <div class="grid gap-3 sm:grid-cols-2">
              {
                contact.serviceOptions.map((option) => (
                  <label class="check">
                    <input type="checkbox" name="services" value={option} />
                    <span>{option}</span>
                  </label>
                ))
              }
            </div>
            <p class="field-error" id="services-error"></p>
          </fieldset>

          <div class="field">
            <label for="people">Number of people <span aria-hidden="true">*</span></label>
            <input class="input" id="people" name="people" type="number" inputmode="numeric" min="1" max="30" required aria-describedby="people-hint people-error" />
            <span class="hint" id="people-hint">Including the bride.</span>
            <p class="field-error" id="people-error"></p>
          </div>

          <div class="field sm:col-span-2">
            <label for="message">Anything else we should know?</label>
            <textarea class="input" id="message" name="message" maxlength="3000" aria-describedby="message-hint"></textarea>
            <span class="hint" id="message-hint">Timings, the look you have in mind, allergies or skin sensitivities.</span>
          </div>

          <!-- Honeypot: hidden from people, tempting to bots. -->
          <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
            <label for="website">Leave this empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="sm:col-span-2">
            <button type="submit" class="btn btn-primary" id="submit-btn">
              <span data-label>Send enquiry</span><span class="arrow" aria-hidden="true"></span>
            </button>
            <p class="mt-5 max-w-md text-xs text-muted">
              Your details are used only to reply to your enquiry. By sending, you agree to the <a href="/terms" class="underline underline-offset-4">terms</a>; travel costs are added to your quote.
            </p>
          </div>
        </form>
      </div>

      <aside class="md:col-span-4 md:col-start-9" aria-label="Contact details">
        <h2 class="h3" set:html={em(contact.detailsHeading)} />
        <ul class="mt-6 space-y-4 border-t border-line pt-6">
          {has(settings.email) && <li><a class="text-ink hover:text-gold-deep" href={`mailto:${settings.email}`}>{settings.email}</a></li>}
          {has(settings.phone) && <li><a class="text-ink hover:text-gold-deep" href={telHref(settings.phone)}>{settings.phone}</a></li>}
          <li>
            <a class="text-ink hover:text-gold-deep" href={settings.instagramUrl} target="_blank" rel="noopener noreferrer">
              Instagram @{settings.instagramHandle}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li class="text-muted">We are based in {settings.locality}, {settings.region}, covering the East Midlands and weddings across the UK.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section surface-2" aria-labelledby="faq-heading">
    <div class="wrap grid gap-10 md:grid-cols-12 md:gap-8">
      <h2 id="faq-heading" class="h2 md:col-span-4" set:html={em(faqs.heading)} />
      <div class="md:col-span-7 md:col-start-6"><FaqList /></div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#enquiry-form')!;
  const success = document.querySelector<HTMLElement>('#form-success')!;
  const failure = document.querySelector<HTMLElement>('#form-error')!;
  const button = document.querySelector<HTMLButtonElement>('#submit-btn')!;
  const label = button.querySelector<HTMLElement>('[data-label]')!;

  // Landing from a service page: tick that service.
  const wanted = new URLSearchParams(location.search).get('service')?.toLowerCase();
  if (wanted) {
    form.querySelectorAll<HTMLInputElement>('input[name="services"]').forEach((box) => {
      if (box.value.toLowerCase() === wanted || wanted.includes(box.value.toLowerCase())) box.checked = true;
    });
  }

  // Past dates make no sense for a wedding.
  const dateInput = form.elements.namedItem('date') as HTMLInputElement;
  dateInput.min = new Date().toISOString().slice(0, 10);

  const setError = (id: string, message: string) => {
    const el = document.getElementById(`${id}-error`);
    const field = document.getElementById(id) ?? form.querySelector(`[name="${id}"]`);
    if (el) el.textContent = message;
    if (field && field instanceof HTMLElement && field.tagName !== 'FIELDSET') {
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
    }
  };

  const validate = () => {
    const data = new FormData(form);
    const errors: Record<string, string> = {};
    const text = (k: string) => String(data.get(k) ?? '').trim();

    if (!text('name')) errors.name = 'Please enter your name.';
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(text('email'))) errors.email = 'Please enter a valid email address.';
    if (text('phone').replace(/\D/g, '').length < 7) errors.phone = 'Please enter a phone number we can reach you on.';
    if (!text('date')) errors.date = 'Please choose your wedding date.';
    else if (text('date') < dateInput.min) errors.date = 'Please choose a date in the future.';
    if (!text('venue')) errors.venue = 'Please tell us where the wedding is.';
    if (data.getAll('services').length === 0) errors.services = 'Please choose at least one service.';
    const people = Number(text('people'));
    if (!Number.isInteger(people) || people < 1 || people > 30) errors.people = 'Please enter a number between 1 and 30.';

    ['name', 'email', 'phone', 'date', 'venue', 'services', 'people'].forEach((k) => setError(k, errors[k] ?? ''));
    return errors;
  };

  // Clear an error as soon as the visitor fixes it.
  form.addEventListener('input', () => {
    if (form.querySelector('[aria-invalid="true"], .field-error:not(:empty)')) validate();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    failure.classList.add('hidden');
    const errors = validate();
    const first = Object.keys(errors)[0];
    if (first) {
      const target = form.querySelector<HTMLElement>(first === 'services' ? 'input[name="services"]' : `#${first}`);
      target?.focus();
      return;
    }

    button.disabled = true;
    label.textContent = 'Sending…';
    try {
      const data = new FormData(form);
      const payload = {
        name: data.get('name'),
        email: data.get('email'),
        phone: data.get('phone'),
        date: data.get('date'),
        venue: data.get('venue'),
        services: data.getAll('services'),
        people: Number(data.get('people')),
        message: data.get('message'),
        website: data.get('website'),
      };
      const res = await fetch('/api/enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('failed');
      form.classList.add('hidden');
      success.classList.remove('hidden');
      success.focus();
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      failure.classList.remove('hidden');
      failure.focus();
    } finally {
      button.disabled = false;
      label.textContent = 'Send enquiry';
    }
  });
</script>

<!-- No-JS fallback: the enquiry function redirects to #form-success or #form-error. -->
<style is:global>
  #form-success:target,
  #form-error:target {
    display: block;
  }
  #form-success:target ~ #enquiry-form {
    display: none;
  }
</style>
