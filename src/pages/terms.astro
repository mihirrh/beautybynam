---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatDate } from '../lib/site';

const entry = (await getEntry('legal', 'terms'))!;
const { Content } = await render(entry);
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Terms & Conditions', path: '/terms' },
];
---

<Base page="terms" breadcrumbs={trail}>
  <PageHeader eyebrow="Legal" title={entry.data.title} intro={entry.data.intro} trail={trail} />
  <section class="pb-28 md:pb-44">
    <div class="wrap">
      <div class="prose-lux">
        <p class="text-sm">Last updated {formatDate(entry.data.updated)}</p>
        <Content />
      </div>
    </div>
  </section>
</Base>
