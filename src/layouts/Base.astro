---
import type { ImageMetadata } from 'astro';
import { settings, seo, cleanHref, type PageKey } from '../lib/site';
import { businessSchema, personSchema, websiteSchema, breadcrumbSchema } from '../lib/schema';
import { media } from '../lib/media';
import { getImage } from 'astro:assets';
import sealImage from '../assets/brand/logo.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import display300 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url';
import display300Italic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-italic.woff2?url';
import sans300 from '@fontsource/dm-sans/files/dm-sans-latin-300-normal.woff2?url';

interface Props {
  /** Key into src/content/site/seo.json. Used when title/description are not given. */
  page?: PageKey;
  title?: string;
  description?: string;
  /** Repository path or ImageMetadata for the social share image. */
  image?: string | ImageMetadata;
  /** Let the first section run behind a transparent header. */
  overlay?: boolean;
  noindex?: boolean;
  type?: 'website' | 'article';
  breadcrumbs?: { name: string; path: string }[];
  /** Extra JSON-LD blocks for the page. */
  schema?: Record<string, unknown>[];
  includeBusiness?: boolean;
}

const {
  page,
  noindex = false,
  type = 'website',
  breadcrumbs,
  schema = [],
  overlay = false,
  includeBusiness = false,
} = Astro.props;

const fromCms = page ? seo[page] : undefined;
const title = Astro.props.title ?? fromCms?.title ?? settings.businessName;
const description = Astro.props.description ?? fromCms?.description ?? '';

const site = Astro.site!;
const pathname = cleanHref(Astro.url.pathname);
const canonical = new URL(pathname, site).toString();

// Social image: page override → CMS page image → site default. Rendered to a
// 1200×630 JPEG so every platform gets the same crop.
const rawImage = Astro.props.image ?? (fromCms?.image || settings.defaultShareImage);
const shareSource = typeof rawImage === 'string' ? media(rawImage) : rawImage;
const share = await getImage({ src: shareSource, width: 1200, height: 630, format: 'jpg', quality: 82, fit: 'cover' });
const shareUrl = new URL(share.src, site).toString();

const sealLogo = await getImage({ src: sealImage, width: 512, format: 'png' });
const schemaGraph = [
  ...(includeBusiness ? [websiteSchema(site), businessSchema(site, new URL(sealLogo.src, site).toString()), personSchema(site)] : []),
  ...(breadcrumbs && breadcrumbs.length > 1
    ? [breadcrumbSchema(site, breadcrumbs)]
    : []),
  ...schema,
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FDFCF0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}

    {[display300, display300Italic, sans300].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content={settings.businessName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />

    <!-- Decide motion before first paint so content never flashes in and out. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion-ok');
    </script>

    {schemaGraph.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <Header overlay={overlay} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
