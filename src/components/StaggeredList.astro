---
/**
 * Children marked data-reveal (or wrapped in <FadeIn>) arrive one after another,
 * about 80 ms apart, instead of all at once. Same hook as FadeIn: see src/scripts/site.ts.
 */
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class={className} data-stagger><slot /></Tag>
