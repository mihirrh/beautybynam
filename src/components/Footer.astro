---
import { Image } from 'astro:assets';
import seal from '../assets/brand/logo-seal.png';
import { settings, has, telHref } from '../lib/site';

const year = new Date().getFullYear();
const nav = settings.nav;
---

<footer class="site-footer border-t border-line bg-ink-2">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <a href="/" class="inline-block" aria-label="Beauty by Nam, home">
        <Image src={seal} alt="Beauty by Nam logo" width={120} height={120} loading="lazy" class="h-[7.5rem] w-[7.5rem]" />
      </a>
      <p class="mt-6 max-w-sm text-muted">{settings.footerBlurb}</p>
    </div>

    <nav aria-label="Footer" class="md:col-span-3">
      <p class="eyebrow mb-5">Explore</p>
      <ul class="space-y-3">
        {nav.map((item) => (
          <li><a href={item.href} class="text-cream/90 hover:text-champagne">{item.label}</a></li>
        ))}
        <li><a href="/terms" class="text-cream/90 hover:text-champagne">Terms &amp; Conditions</a></li>
      </ul>
    </nav>

    <div class="md:col-span-4">
      <p class="eyebrow mb-5">Get in touch</p>
      <ul class="space-y-3 text-cream/90">
        <li><a href="/contact" class="hover:text-champagne">Booking enquiry form</a></li>
        {has(settings.email) && <li><a href={`mailto:${settings.email}`} class="hover:text-champagne">{settings.email}</a></li>}
        {has(settings.phone) && <li><a href={telHref(settings.phone)} class="hover:text-champagne">{settings.phone}</a></li>}
        <li>
          <a href={settings.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-champagne">
            Instagram @{settings.instagramHandle}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li class="text-muted">Based in {settings.locality}, {settings.region}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="wrap py-6 text-xs tracking-wide text-muted">
      © {year} {settings.businessName}. All rights reserved.
    </p>
  </div>
</footer>
