---
import { instagram, home, settings } from '../lib/site';
import { media } from '../lib/media';
import { em } from '../lib/text';
import Photo from './Photo.astro';

const c = home.instagram;
const total = String(instagram.items.length).padStart(2, '0');
---

<section class="section overflow-x-clip" aria-labelledby="insta-heading">
  <div class="wrap">
    <div class="grid items-end gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-7" data-stagger>
        <p class="eyebrow" data-reveal>{c.eyebrow}</p>
        <h2 id="insta-heading" class="h2 mt-6" data-reveal set:html={em(c.heading)} />
      </div>
      <p class="text-muted md:col-span-4 md:col-start-9" data-reveal>{c.text}</p>
    </div>
  </div>

  <!-- A swipeable stack of cards: swipe, drag the trackpad, use the arrows or the keyboard. -->
  <div class="mt-16 md:mt-24" data-cards role="region" aria-roledescription="carousel" aria-label="Instagram posts and reels">
    <ul class="cards pb-6 pt-4" data-track tabindex="0" aria-label="Scrolling list of posts. Use the left and right arrow keys to move through them.">
      {
        instagram.items.map((post, i) => (
          <li class="card" data-card style={`--y:${i % 2 === 0 ? '0' : '2.5rem'}`}>
            <a href={post.link || settings.instagramUrl} target="_blank" rel="noopener noreferrer" class="block">
              {post.kind === 'reel' && <span class="card-badge">Reel</span>}
              <Photo
                src={media(post.image)}
                alt={post.alt}
                ratio="4 / 5"
                zoom
                reveal={false}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 27vw, 70vw"
              />
              <span class="sr-only">
                View {post.kind === 'reel' ? 'reel' : 'post'} {i + 1} of {total} on Instagram (opens in a new tab)
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="wrap mt-8 flex items-center justify-between gap-6" data-controls hidden>
      <div class="flex items-center gap-5">
        <button type="button" class="round-btn prev" data-prev aria-label="Previous posts"><span></span></button>
        <button type="button" class="round-btn next" data-next aria-label="Next posts"><span></span></button>
      </div>
      <div class="hidden flex-1 sm:block" aria-hidden="true">
        <div class="h-px bg-hair"><div class="h-px origin-left bg-gold-deep transition-transform duration-300" style="transform:scaleX(0.1)" data-bar></div></div>
      </div>
      <p class="font-display text-xl tabular-nums text-muted" data-count aria-hidden="true">01 / {total}</p>
    </div>
  </div>

  <div class="wrap mt-16 flex flex-col items-start gap-5 md:mt-20 md:flex-row md:items-center md:gap-10">
    <a href={settings.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn">
      {c.buttonLabel}<span class="arrow" aria-hidden="true"></span>
      <span class="sr-only">(opens in a new tab)</span>
    </a>
    <p class="text-sm text-muted">A hand-picked selection, not a live feed. Every card opens on Instagram.</p>
  </div>
</section>
