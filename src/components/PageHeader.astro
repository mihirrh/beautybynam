---
import Breadcrumbs from './Breadcrumbs.astro';
import { em } from '../lib/text';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  trail: { name: string; path: string }[];
  /** Headings on inner pages are the page <h1>. */
  class?: string;
}
const { eyebrow, title, intro, trail, class: className = '' } = Astro.props;
---

<header class:list={['wrap pb-16 pt-40 md:pb-28 md:pt-60', className]}>
  <Breadcrumbs trail={trail} />
  <div class="mt-14 max-w-5xl" data-stagger>
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1 class="h1 mt-6" data-reveal set:html={em(title)} />
    {intro && <p class="lede mt-9" data-reveal>{intro}</p>}
  </div>
</header>
