---
import { faqs } from '../lib/site';
---

<div class="divide-y divide-hair border-y border-hair">
  {
    faqs.items.map((item) => (
      <details class="group py-6">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-2xl text-ink marker:hidden [&::-webkit-details-marker]:hidden">
          <span>{item.question}</span>
          <span class="mt-2 block h-3 w-3 flex-none border-b border-r border-gold-deep rotate-45 transition-transform duration-300 group-open:-rotate-[135deg]" aria-hidden="true"></span>
        </summary>
        <p class="mt-4 max-w-xl text-muted">{item.answer}</p>
      </details>
    ))
  }
</div>
