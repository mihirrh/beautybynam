---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Responsive, format-negotiated photo. AVIF + WebP with a JPEG fallback.
 * Intrinsic width/height come from the source file, so no layout shift.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  ratio?: string;
  reveal?: boolean;
  keyline?: boolean;
  zoom?: boolean;
  position?: string;
}

const {
  src,
  alt,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  widths = [480, 768, 1100, 1600],
  priority = false,
  class: className = '',
  ratio,
  reveal = true,
  keyline = false,
  zoom = false,
  position = 'center',
} = Astro.props;

const classes = ['photo', keyline && 'photo-keyline', zoom && 'photo-zoom', className]
  .filter(Boolean)
  .join(' ');
---

<div
  class={classes}
  style={ratio ? `aspect-ratio:${ratio}` : undefined}
  data-reveal-img={reveal && !priority ? '' : undefined}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={widths.filter((w) => w <= src.width)}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    quality={78}
    style={`object-position:${position}`}
  />
</div>
