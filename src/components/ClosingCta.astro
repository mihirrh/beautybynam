---
import { home } from '../lib/site';
import { media } from '../lib/media';
import { em } from '../lib/text';
import Photo from './Photo.astro';
import GoldRing from './GoldRing.astro';

const c = home.closingCta;
---

<section class="surface-2 relative isolate overflow-x-clip" aria-labelledby="closing-cta-heading">
  <div class="wrap grid items-center gap-16 py-[var(--section)] md:grid-cols-12 md:gap-8">
    <div class="relative z-10 md:col-span-6" data-stagger>
      <p class="eyebrow" data-reveal>{c.eyebrow}</p>
      <h2 id="closing-cta-heading" class="h2 mt-6" data-reveal set:html={em(c.heading)} />
      <p class="lede mt-8" data-reveal>{c.text}</p>
      <div class="mt-12" data-reveal>
        <a href="/contact" class="btn btn-primary">{c.buttonLabel}<span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
    <div class="relative md:col-span-5 md:col-start-8">
      <GoldRing class="pointer-events-none absolute -right-12 -top-14 z-0 h-[118%] w-[118%] max-w-none opacity-90" />
      <Photo
        src={media(c.image)}
        alt={c.imageAlt}
        ratio="4 / 5"
        drift
        class="relative z-10"
        widths={[480, 768, 1100]}
        sizes="(min-width: 768px) 38vw, 100vw"
      />
    </div>
  </div>
</section>
